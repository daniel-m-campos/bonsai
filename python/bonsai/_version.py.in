"""Build-time version stamp, generated by CMake from pyproject.toml.

This file lives only in the build tree (build/python/bonsai,
build-cuda/python/bonsai). It is never installed and never part of a
wheel, so ``bonsai.__init__`` treats its presence as proof the running
module came from a source build rather than an installed distribution.
"""

from __future__ import annotations

__version__ = "@BONSAI_PYPROJECT_VERSION@"
